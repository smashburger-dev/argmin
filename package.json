{
  "name": "ki-lernplattform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:project-runner": "python3 -m unittest tests/test_learner_project_check.py tests/test_foundations_project_solution.py tests/test_rag_capstone_project_solution.py",
    "coverage:build": "node tools/build_coverage_matrix.mjs",
    "coverage:check": "node tools/build_coverage_matrix.mjs --check",
    "pretypecheck": "npm run content:compile && npm run coverage:check",
    "typecheck": "tsc --noEmit",
    "predev:next": "npm run content:compile && npm run coverage:check",
    "dev:next": "vite --host 127.0.0.1 --port 4173",
    "prebuild:next": "npm run content:compile && npm run coverage:check",
    "build:next": "vite build && node tools/build_public.mjs --out build-next --next-dir .next-ui && node tools/validate_content.mjs --dir build-next && node tools/validate_next_build.mjs build-next",
    "build:release": "npm run build:next",
    "preview:next": "vite preview --outDir build-next --host 127.0.0.1",
    "content:migrate": "node tools/migrate_legacy_content.mjs",
    "content:compile": "node tools/compile_content.mjs --profile public",
    "content:compile:local": "node tools/compile_content.mjs --profile local-private",
    "predev:local": "npm run content:compile:local",
    "dev:local": "vite --mode local-private --host 127.0.0.1 --port 4174",
    "prebuild:local": "npm run content:compile:local",
    "build:local": "vite build --mode local-private --outDir .next-local-ui",
    "validate": "node tools/validate_content.mjs",
    "build:public": "node tools/build_public.mjs",
    "pretest:e2e": "npm run content:compile && node tools/pyodide_contract_matrix.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e:build": "node tools/pyodide_contract_matrix.mjs",
    "test:e2e:build": "npm run build:next && PLAYWRIGHT_PREVIEW=1 playwright test --project=chromium",
    "verify:release": "npm test && npm run test:project-runner && npm run typecheck && npm run test:e2e && npm run test:e2e:build"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "codemirror": "6.0.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdown-it": "15.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
