# Dependencies
/node_modules/

# Generated outputs
/build-next/
/.next-ui/
/.next-local-ui/
/.content-build/
/playwright-report/
/test-results/
/graphify-out/

# Required vendored runtime files overridden from the workspace-wide ignores
!/vendor/katex/dist/
/vendor/katex/dist/**
!/vendor/katex/dist/contrib/
!/vendor/katex/dist/contrib/auto-render.min.js
!/vendor/katex/dist/fonts/
!/vendor/katex/dist/fonts/*.woff2
!/vendor/katex/dist/katex.min.css
!/vendor/katex/dist/katex.min.js

# Pyodide contract sources hidden by the workspace-wide *Contract* ignore;
# negate exactly these three tracked files, never a broad contract pattern.
!/tools/pyodide_contract_matrix.mjs
!/tests/pyodide_contract_matrix.test.mjs
!/tests/e2e/pyodide-contracts.spec.ts
# Generated contract artifacts stay ignored independently of the root rules.
/tests/e2e/pyodide-contract-matrix.json
/tests/e2e/pyodide-contract-receipt.json

# Browser acceptance profiles and local scratch data
/.tmp-acceptance-*/
/vendor/tmp/

# Local-only configuration and secrets
/.env
/.env.*
!/.env.example
/*.local.json

# Operating-system files
.DS_Store

# leaked validator temp dirs from interrupted test runs
tmp-validate-neg-*/
.tmp-validate-neg-*/

# LLM training artifacts stay private (B3). Registry plus script are tracked.
private/llm/adapters/
private/llm/datasets/
private/llm/runs/
teacher-traces.jsonl
verified-traces.jsonl
teacher-cost.json
verify-report.json
eval-report.json

# Private LLM training data (Spec B1/B3): never in release tree
/private/llm/
__pycache__/
/tests/fixtures/llm-benchmark.*.json
