{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/research/streamlining/s4a/shard.schema.json",
  "title": "S4A migration taxonomy shard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysisSchemaVersion",
    "shardId",
    "scope",
    "entries"
  ],
  "properties": {
    "analysisSchemaVersion": {
      "const": "s4a-taxonomy-v1"
    },
    "shardId": {
      "enum": [
        "foundations",
        "linear-algebra",
        "data-ml",
        "deep-learning",
        "transformer-llm",
        "genai-systems",
        "research-capstone"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "weekIds",
        "definitionRoots",
        "expectedEntryCount"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "weekIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^w(?:0[1-9]|[12][0-9]|3[0-9])$"
          },
          "uniqueItems": true
        },
        "definitionRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^content/exercise-definitions/[a-z0-9-]+/$"
          },
          "uniqueItems": true
        },
        "expectedEntryCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceFile",
        "sourceId",
        "currentDefinitionId",
        "legacyWeekId",
        "competencyIds",
        "learningObjective",
        "activityType",
        "graderId",
        "generatorId",
        "referenceSolverId",
        "currentDifficulty",
        "proposedFamilyId",
        "proposedCaseType",
        "proposedDifficultyProfile",
        "answerContract",
        "solverContract",
        "feedbackRuleCount",
        "feedbackConsumerStatus",
        "semanticClassification",
        "targetAction",
        "targetRationale",
        "preservedDidacticContent",
        "persistenceCompatibility",
        "uncertainty",
        "evidence",
        "humanReviewRequired",
        "humanReviewReasons"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "legacy-week-exercise",
            "canonical-definition"
          ]
        },
        "sourceFile": {
          "type": "string",
          "pattern": "^content/(?:exercises/w(?:0[1-9]|[12][0-9]|3[0-9])\\.json|exercise-definitions/[a-z0-9-]+/[a-z0-9-]+\\.json)$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "description": "Natürliche exerciseId oder definitionId aus der Quelle; keine synthetische Composite-ID."
        },
        "currentDefinitionId": {
          "type": "string",
          "minLength": 1,
          "description": "Heute vom Compiler beziehungsweise Adapter verwendete Definition-ID."
        },
        "legacyWeekId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^w(?:0[1-9]|[12][0-9]|3[0-9])$"
        },
        "competencyIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^c-[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "lessonIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "lessonCandidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lessonCandidate"
          }
        },
        "learningObjective": {
          "type": "string",
          "minLength": 20,
          "description": "Beobachtbare Tätigkeit der lernenden Person, nicht nur ein Themenlabel."
        },
        "activityType": {
          "type": "string",
          "minLength": 1
        },
        "graderId": {
          "type": "string",
          "minLength": 1
        },
        "generatorId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "referenceSolverId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "currentDifficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "proposedFamilyId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Nur Aufgaben mit gleichem Lösungsweg, Answer-/Solver-Vertrag, Darstellungstyp und Transferanspruch teilen eine Familie."
        },
        "proposedCaseType": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Fachlich benannter Struktur-, Darstellungs- oder Transfersfall innerhalb einer Familie."
        },
        "proposedDifficultyProfile": {
          "enum": [
            "basic-recall",
            "core-application",
            "advanced-transfer",
            "final-boss-synthesis"
          ]
        },
        "answerContract": {
          "$ref": "#/$defs/answerContract"
        },
        "solverContract": {
          "$ref": "#/$defs/solverContract"
        },
        "feedbackRuleCount": {
          "type": "integer",
          "minimum": 0
        },
        "feedbackConsumerStatus": {
          "enum": [
            "fully-consumed",
            "partially-consumed",
            "not-consumed",
            "no-rules",
            "unknown"
          ]
        },
        "semanticClassification": {
          "enum": [
            "unique",
            "mechanically-similar",
            "obsolete",
            "local-only"
          ]
        },
        "targetAction": {
          "enum": [
            "preserve",
            "migrate",
            "merge-after-extraction",
            "replace",
            "retire-after-approval"
          ]
        },
        "targetRationale": {
          "type": "string",
          "minLength": 30
        },
        "preservedDidacticContent": {
          "$ref": "#/$defs/preservedDidacticContent"
        },
        "persistenceCompatibility": {
          "$ref": "#/$defs/persistenceCompatibility"
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uncertainty"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "humanReviewRequired": {
          "type": "boolean"
        },
        "humanReviewReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          },
          "uniqueItems": true
        },
        "comparisonSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "lessonIds": true
          },
          "required": [
            "lessonIds"
          ]
        },
        {
          "properties": {
            "lessonCandidates": true
          },
          "required": [
            "lessonCandidates"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "humanReviewRequired": {
                "const": true
              }
            },
            "required": [
              "humanReviewRequired"
            ]
          },
          "then": {
            "properties": {
              "humanReviewReasons": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "targetAction": {
                "const": "retire-after-approval"
              }
            },
            "required": [
              "targetAction"
            ]
          },
          "then": {
            "properties": {
              "humanReviewRequired": {
                "const": true
              },
              "targetRationale": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "feedbackRuleCount": {
                "const": 0
              }
            },
            "required": [
              "feedbackRuleCount"
            ]
          },
          "then": {
            "properties": {
              "feedbackConsumerStatus": {
                "const": "no-rules"
              }
            }
          },
          "else": {
            "properties": {
              "feedbackConsumerStatus": {
                "not": {
                  "const": "no-rules"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "legacy-week-exercise"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "properties": {
              "sourceFile": {
                "type": "string",
                "pattern": "^content/exercises/w(?:0[1-9]|[12][0-9]|3[0-9])\\.json$"
              },
              "legacyWeekId": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "canonical-definition"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "properties": {
              "sourceFile": {
                "type": "string",
                "pattern": "^content/exercise-definitions/[a-z0-9-]+/[a-z0-9-]+\\.json$"
              }
            }
          }
        }
      ]
    },
    "lessonCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "confidence",
        "reason"
      ],
      "properties": {
        "lessonId": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "answerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "inputShape",
        "comparison",
        "tolerance"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "inputShape": {
          "type": "string",
          "minLength": 3
        },
        "comparison": {
          "type": "string",
          "minLength": 3
        },
        "tolerance": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "solverContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authoritative",
        "contract",
        "testEvidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "expected-answer",
            "seed-generator",
            "reference-solver",
            "hidden-tests",
            "sympy-equivalence",
            "manual-rubric",
            "numbas-exam"
          ]
        },
        "authoritative": {
          "type": "boolean"
        },
        "contract": {
          "type": "string",
          "minLength": 10
        },
        "testEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        }
      }
    },
    "preservedDidacticContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solutionPath",
        "errorPatterns",
        "representation",
        "transferDemand",
        "difficultyRationale",
        "uniqueElements"
      ],
      "properties": {
        "solutionPath": {
          "type": "string",
          "minLength": 15
        },
        "errorPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          },
          "uniqueItems": true
        },
        "representation": {
          "type": "string",
          "minLength": 5
        },
        "transferDemand": {
          "type": "string",
          "minLength": 10
        },
        "difficultyRationale": {
          "type": "string",
          "minLength": 10
        },
        "uniqueElements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          },
          "uniqueItems": true
        }
      }
    },
    "persistenceCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "currentAttemptDefinitionId",
        "requiredAction"
      ],
      "properties": {
        "status": {
          "enum": [
            "preserve-id",
            "alias-required",
            "merge-map-required",
            "retire-blocked",
            "no-attempt-impact",
            "unknown"
          ]
        },
        "currentAttemptDefinitionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiredAction": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "level",
        "reason",
        "resolution"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10
        },
        "resolution": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file",
        "pointer",
        "note"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-field",
            "runtime-contract",
            "lesson-match",
            "comparison",
            "rights-status",
            "persistence-contract"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/.*|n/a)$"
        },
        "note": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
