{
  "schemaVersion": 1,
  "engine": "jsxgraph",
  "title": "Spann und Determinante",
  "caption": "Ziehe k und s: Das Parallelogramm zeigt, wie sich der aufgespannte Bereich mit der Determinante ändert.",
  "boundingbox": [-5, 8, 8, -5],
  "sliders": [
    { "name": "k", "label": "k", "range": [-2, 2], "value": 1, "step": 0.1 },
    { "name": "s", "label": "s", "range": [0, 3], "value": 1, "step": 0.1 }
  ],
  "objects": [
    { "kind": "arrow", "from": [0, 0], "to": [2, 1], "label": "u", "color": "#16713a" },
    { "kind": "arrow", "from": [0, 0], "to": ["2*k", "k+s"], "label": "v", "color": "#9c4b00" },
    { "kind": "polygon", "points": [[0, 0], [2, 1], ["2+2*k", "1+k+s"], ["2*k", "k+s"]], "color": "#294bd6" },
    { "kind": "text", "at": [-4, -3], "text": "det(u,v) = {2*s}", "color": "#294bd6" },
    { "kind": "text", "at": [-4, -4], "text": "Vorhersage: Bei welchem s wird det(u,v) = 0 — und hängt das von k ab? Erst schätzen, dann mit den Slidern prüfen.", "color": "#b72f2a" }
  ]
}
