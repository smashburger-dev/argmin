{
  "schemaVersion": 1,
  "engine": "jsxgraph",
  "title": "Precision-Recall-Schwellwert",
  "caption": "Ziehe t: Precision steigt, Recall sinkt und der F1-Punkt zeigt den Kompromiss am aktuellen Schwellwert.",
  "boundingbox": [-0.1, 1.1, 1.1, -0.1],
  "sliders": [{ "name": "t", "label": "t", "range": [0, 1], "value": 0.5, "step": 0.01 }],
  "objects": [
    { "kind": "functiongraph", "expr": "0.5+0.5*x", "label": "Precision", "color": "#16713a" },
    { "kind": "functiongraph", "expr": "1-x^2", "label": "Recall", "color": "#9c4b00" },
    { "kind": "functiongraph", "expr": "2*(0.5+0.5*x)*(1-x^2)/(0.5+0.5*x+1-x^2)", "label": "F1", "color": "#294bd6" },
    { "kind": "point", "at": ["t", "0.5+0.5*t"], "label": "Precision", "color": "#16713a" },
    { "kind": "point", "at": ["t", "1-t^2"], "label": "Recall", "color": "#9c4b00" },
    { "kind": "point", "at": ["t", "2*(0.5+0.5*t)*(1-t^2)/(0.5+0.5*t+1-t^2)"], "label": "F1", "color": "#b72f2a" },
    { "kind": "text", "at": [0, -0.05], "text": "P={0.5+0.5*t}, R={1-t^2}, F1={2*(0.5+0.5*t)*(1-t^2)/(0.5+0.5*t+1-t^2)}", "color": "#294bd6" }
  ],
  "checkpoint": {
    "prompt": "Setze t = 0,5. Welchen Wert hat F1 am aktuellen Schwellwert?",
    "input": "numeric",
    "expected": 0.75,
    "tolerance": 1e-6,
    "hints": ["Berechne zuerst P = 0,5 + 0,5t und R = 1 − t², dann F1 = 2PR/(P+R)."],
    "typicalErrors": [
      { "match": 1.125, "feedback": "Das ist 2PR ohne den Nenner — F1 ist das harmonische Mittel 2PR/(P+R)." },
      { "match": 0.56, "feedback": "P·R ≈ 0,56 ist nicht F1 — F1 = 2PR/(P+R)." }
    ]
  }
}
