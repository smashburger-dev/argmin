{
  "schemaVersion": 1,
  "engine": "jsxgraph",
  "title": "Sigmoid und Schwellwert",
  "caption": "Ziehe w und b: Die Sigmoidkurve und ihre Entscheidungsgrenze bei 0,5 verschieben sich sichtbar.",
  "boundingbox": [-6, 1.2, 6, -0.2],
  "sliders": [
    { "name": "w", "label": "w", "range": [0.5, 4], "value": 1, "step": 0.1 },
    { "name": "b", "label": "b", "range": [-3, 3], "value": 0, "step": 0.1 }
  ],
  "objects": [
    { "kind": "functiongraph", "expr": "sigmoid(w*x+b)", "color": "#294bd6" },
    { "kind": "segment", "from": [-6, 0.5], "to": [6, 0.5], "dash": true, "color": "#9c4b00" },
    { "kind": "point", "at": ["-b/w", 0.5], "label": "Grenze", "color": "#b72f2a" },
    { "kind": "text", "at": [-5.5, 0.1], "text": "Grenze x = {-b/w}", "color": "#b72f2a" }
  ]
}
