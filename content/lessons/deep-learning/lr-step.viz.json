{
  "schemaVersion": 1,
  "engine": "jsxgraph",
  "title": "Ein Gradientenschritt",
  "caption": "Ziehe x₀ und die Lernrate: Der Pfeil zeigt den Schritt x₁ = x₀ − lr·2x₀ auf der Parabel.",
  "boundingbox": [-5, 18, 5, -2],
  "sliders": [
    { "name": "x0", "label": "x₀", "range": [-3, 3], "value": 2, "step": 0.1 },
    { "name": "lr", "label": "lr", "range": [0, 1.2], "value": 0.2, "step": 0.05 }
  ],
  "objects": [
    { "kind": "functiongraph", "expr": "x^2", "color": "#294bd6" },
    { "kind": "point", "at": ["x0", "x0^2"], "label": "x₀", "color": "#b72f2a" },
    { "kind": "point", "at": ["x0-lr*2*x0", "(x0-lr*2*x0)^2"], "label": "x₁", "color": "#16713a" },
    { "kind": "arrow", "from": ["x0", "x0^2"], "to": ["x0-lr*2*x0", "(x0-lr*2*x0)^2"], "color": "#9c4b00" },
    { "kind": "text", "at": [-4.5, -1], "text": "x₁ = {x0-lr*2*x0}", "color": "#294bd6" }
  ]
}
