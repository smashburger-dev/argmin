{
  "schemaVersion": 1,
  "engine": "jsxgraph",
  "title": "Schwellwert und Verzweigung",
  "caption": "Ziehe t: Die ReLU-Funktion zeigt, ab welchem Schwellwert der if-Zweig aktiv wird.",
  "boundingbox": [-5, 6, 6, -2],
  "sliders": [{ "name": "t", "label": "t", "range": [-2, 3], "value": 0, "step": 0.1 }],
  "objects": [
    { "kind": "functiongraph", "expr": "relu(x-t)", "label": "relu(x−t)", "color": "#294bd6" },
    { "kind": "segment", "from": ["t", 0], "to": ["t", 5], "dash": true, "color": "#b72f2a" },
    { "kind": "text", "at": [-4.5, -1], "text": "if x > t", "color": "#b72f2a" }
  ]
}
