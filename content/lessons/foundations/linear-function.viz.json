{
  "schemaVersion": 1,
  "engine": "jsxgraph",
  "title": "Lineare Funktion",
  "caption": "Ziehe m und b: Du siehst, wie Steigung und y-Achsenabschnitt die Gerade verändern.",
  "boundingbox": [-6, 8, 8, -6],
  "sliders": [
    { "name": "m", "label": "m", "range": [0.5, 3], "value": 1.5, "step": 0.1 },
    { "name": "b", "label": "b", "range": [-3, 3], "value": 1, "step": 0.1 }
  ],
  "objects": [
    { "kind": "functiongraph", "expr": "m*x+b", "color": "#294bd6" },
    { "kind": "point", "at": ["-b/m", 0], "label": "x₀", "color": "#b72f2a" },
    { "kind": "point", "at": [0, "b"], "label": "b", "color": "#16713a" },
    { "kind": "text", "at": [-5.5, -4.5], "text": "x₀ = {-b/m}", "color": "#b72f2a" }
  ]
}
