{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argmin.local/schemas/capsule-bank.schema.json",
  "title": "Capsule bank",
  "type": "object",
  "required": ["capsules"],
  "additionalProperties": false,
  "dependentRequired": {
    "contract": ["shapeError"]
  },
  "properties": {
    "capsules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/capsule" }
    },
    "contract": { "$ref": "#/$defs/contract" },
    "shapeError": { "type": "string", "minLength": 1 },
    "keyBy": { "enum": ["difficulty", "caseId"] }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "graderId",
        "activityType",
        "familyId",
        "familyGroup",
        "summary",
        "taskArchetype",
        "authorityMode",
        "masteryEligible",
        "caseTypes",
        "difficultyProfiles",
        "competencyIds"
      ],
      "additionalProperties": false,
      "properties": {
        "graderId": { "type": "string", "minLength": 1 },
        "activityType": { "type": "string", "minLength": 1 },
        "familyId": { "type": "string", "minLength": 1 },
        "familyGroup": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "taskArchetype": { "type": "string", "minLength": 1 },
        "authorityMode": { "type": "string", "minLength": 1 },
        "masteryEligible": { "type": "boolean" },
        "caseTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["caseId"],
            "properties": {
              "caseId": { "type": "string", "minLength": 1 },
              "propertyTest": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "difficultyProfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "competencyIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capsule": {
      "type": "object",
      "required": ["caseId"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string" },
        "competencyIds": { "type": "array", "items": { "type": "string" } },
        "bank": { "type": "array", "minItems": 1 }
      }
    }
  }
}
