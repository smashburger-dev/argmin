{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argmin.local/schemas/capsule-bank.schema.json",
  "title": "Capsule bank",
  "type": "object",
  "required": ["capsules"],
  "additionalProperties": false,
  "properties": {
    "capsules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/capsule" }
    }
  },
  "$defs": {
    "capsule": {
      "type": "object",
      "required": ["caseId"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string" },
        "competencyIds": { "type": "array", "items": { "type": "string" } },
        "bank": { "type": "array", "minItems": 1 }
      }
    }
  }
}
