{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/figure-hints.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "hints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "hints": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["familyId", "scene", "source", "safety"],
      "properties": {
        "familyId": { "type": "string", "minLength": 1 },
        "caseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "scene": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "source": { "enum": ["case", "neighbor"] },
        "neighborParams": { "type": "object" },
        "safety": { "oneOf": [
          { "$ref": "trace-hint-prefix.schema.json" },
          { "$ref": "figure-hint-parameters.schema.json" }
        ] }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "neighbor" } } }, "then": { "properties": { "neighborParams": {} }, "required": ["neighborParams"] } },
        { "if": { "properties": { "source": { "const": "case" } } }, "then": { "not": { "properties": { "neighborParams": {} }, "required": ["neighborParams"] } } }
      ]
    } }
  }
}
