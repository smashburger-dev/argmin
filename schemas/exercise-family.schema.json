{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/exercise-family.schema.json",
  "title": "Exercise family contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "familyId", "familyGroup", "summary", "taskArchetype", "authorityMode",
    "masteryEligible", "caseTypes", "difficultyProfiles", "competencyIds",
    "graderId", "activityType"
  ],
  "properties": {
    "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "familyGroup": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 1 },
    "taskArchetype": {
      "enum": [
        "numeric-exact", "choice-diagnose", "code-test", "output-predict-lines",
        "state-trace-vars", "program-ordering", "tuple-exact",
        "expression-equivalence", "rationale-note", "numbas-exam-retired"
      ]
    },
    "authorityMode": { "enum": ["static", "seeded"] },
    "masteryEligible": { "type": "boolean" },
    "mergeInto": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "vacuousSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "emptyWhen", "rationale"],
        "properties": {
          "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "emptyWhen": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["intro", "core", "stretch", "challenge"] }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "caseTypes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "propertyTest": { "type": "boolean" }
        }
      }
    },
    "difficultyProfiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["intro", "core", "stretch", "challenge"] }
    },
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
    },
    "graderId": { "enum": ["deterministic", "pyodide", "pyodide-sympy", "manual-rubric"] },
    "activityType": {
      "enum": [
        "numeric", "single-choice", "vector", "algebraic-expression",
        "python-code", "short-rationale", "parsons", "code-trace", "predict-output"
      ]
    }
  }
}
