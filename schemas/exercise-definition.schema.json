{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/exercise-definition.schema.json",
  "title": "Exercise definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definitionId", "version", "locale", "title", "competencyIds", "activityType", "graderId",
    "generatorId", "referenceSolverId", "deterministicSeed", "prompt", "parameters", "expectedAnswer",
    "tolerancePolicy", "hints", "feedbackRules", "fullSolution", "difficulty",
    "estimatedMinutes", "sourceLineage", "rightsId", "releaseStatus", "testedSeedCount",
    "masteryEligible", "active", "legacyWeekId"
  ],
  "properties": {
    "definitionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "const": "de" },
    "title": { "type": "string", "minLength": 1 },
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
    },
    "activityType": {
      "enum": ["numeric", "single-choice", "vector", "algebraic-expression", "python-code", "short-rationale", "parsons", "code-trace", "predict-output"]
    },
    "graderId": { "enum": ["deterministic", "pyodide", "pyodide-sympy", "manual-rubric"] },
    "generatorId": { "type": ["string", "null"] },
    "referenceSolverId": { "type": ["string", "null"] },
    "deterministicSeed": { "type": "integer" },
    "prompt": { "type": "string", "minLength": 1 },
    "parameters": { "type": "object" },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "correct"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "correct": { "type": "boolean" }
        }
      }
    },
    "expectedAnswer": { "type": ["object", "null"] },
    "tolerancePolicy": { "type": "object" },
    "hints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "feedbackRules": { "type": "array", "items": { "type": "object" } },
    "fullSolution": { "type": "string" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "sourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "seed"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" }
      }
    },
    "rightsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "releaseStatus": { "enum": ["draft", "source-verified", "solver-verified", "didactic-reviewed", "browser-verified", "public-approved", "local-only"] },
    "testedSeedCount": { "type": "integer", "minimum": 0 },
    "masteryEligible": { "type": "boolean" },
    "active": { "type": "boolean" },
    "legacyWeekId": { "type": ["string", "null"], "pattern": "^w[0-9]{2}$" },
    "workedExample": { "type": ["object", "null"] },
    "rubric": { "type": ["array", "null"] },
    "typicalErrors": { "type": ["array", "null"] }
  }
}
