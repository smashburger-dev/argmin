{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/competency.schema.json",
  "title": "Competency collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "competencies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "const": "de" },
    "competencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/competency" }
    }
  },
  "$defs": {
    "competencyId": { "type": "string", "pattern": "^c-[a-z0-9-]+$" },
    "releaseStatus": {
      "enum": ["draft", "source-verified", "solver-verified", "didactic-reviewed", "browser-verified", "public-approved", "local-only"]
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyId", "locale", "title", "description", "domain", "level",
        "requires", "relations", "trackIds", "estimatedMinutes", "evidencePolicy",
        "rightsId", "releaseStatus"
      ],
      "properties": {
        "competencyId": { "$ref": "#/$defs/competencyId" },
        "locale": { "const": "de" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "level": { "enum": ["recall", "apply", "transfer"] },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/competencyId" }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "competencyId"],
            "properties": {
              "type": { "enum": ["supports", "related", "usedBy"] },
              "competencyId": { "$ref": "#/$defs/competencyId" }
            }
          }
        },
        "trackIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "evidencePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumIndependentHits", "minimumDistinctDefinitions", "delayedHitRequired", "minimumDelayDays", "freshnessDays"],
          "properties": {
            "minimumIndependentHits": { "type": "integer", "minimum": 1 },
            "minimumDistinctDefinitions": { "type": "integer", "minimum": 1 },
            "delayedHitRequired": { "type": "boolean" },
            "minimumDelayDays": { "type": "integer", "minimum": 0 },
            "freshnessDays": { "type": "integer", "minimum": 1 }
          }
        },
        "rightsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "releaseStatus": { "$ref": "#/$defs/releaseStatus" }
      }
    }
  }
}
