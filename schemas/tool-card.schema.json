{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/tool-card.schema.json",
  "title": "Tool card collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "const": "de" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolId", "title", "summary", "kind", "competencyIds", "routes", "sourceRefs", "capabilities", "limitations", "availability", "rightsId", "releaseStatus"],
        "properties": {
          "toolId": { "type": "string", "pattern": "^t-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["runtime", "workspace", "grader", "cli", "version-control", "visualization", "repository"] },
          "competencyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" } },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href", "type"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "href": { "type": "string", "minLength": 1 },
                "type": { "enum": ["internal", "external"] }
              }
            }
          },
          "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" } },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "availability": { "enum": ["public", "local-only"] },
          "rightsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "releaseStatus": { "enum": ["draft", "source-verified", "solver-verified", "didactic-reviewed", "browser-verified", "public-approved", "local-only"] }
        }
      }
    }
  }
}
