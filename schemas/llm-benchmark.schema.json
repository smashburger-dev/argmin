{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/llm-benchmark.schema.json",
  "title": "LLM benchmark fixture (held oracle instances plus solver-verified mutants)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "builderVersion", "promptVersion", "contentCommit",
    "contentHash", "heldSeedRange", "heldModuloBase", "trainSeedRanges",
    "heldSeeds", "mutantRejectionRate", "uncovered", "items"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "builderVersion": { "type": "string", "minLength": 1 },
    "promptVersion": { "const": null },
    "contentCommit": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "heldSeedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "const": 90000 },
        "end": { "const": 90999 }
      }
    },
    "heldModuloBase": { "const": 10 },
    "trainSeedRanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "integer" },
          "end": { "type": "integer" }
        }
      }
    },
    "heldSeeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer" }
    },
    "mutantRejectionRate": { "const": 1 },
    "uncovered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["familyId", "caseId", "difficulty", "category", "reason"],
        "properties": {
          "familyId": { "type": "string", "minLength": 1 },
          "caseId": { "type": ["string", "null"] },
          "difficulty": { "type": ["string", "null"] },
          "category": { "enum": ["worker-grader", "manual-rubric", "unsupported-type", "no-contract", "unregistered", "verification-failed"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "familyId", "caseId", "difficulty", "heldSeed", "moduloClass",
          "variantCount", "prompt", "parameters", "expectedAnswer",
          "choices", "oracle", "mutants", "provenance"
        ],
        "properties": {
          "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "difficulty": { "enum": ["intro", "core", "stretch", "challenge"] },
          "heldSeed": { "type": "integer" },
          "moduloClass": { "type": "integer", "minimum": 0 },
          "variantCount": { "type": "integer", "minimum": 1 },
          "prompt": {},
          "parameters": {},
          "expectedAnswer": {},
          "choices": { "type": ["array", "null"] },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["solverDigest", "graderId", "activityType"],
            "properties": {
              "solverDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "graderId": { "type": "string", "minLength": 1 },
              "activityType": { "type": "string", "minLength": 1 }
            }
          },
          "mutants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "answer", "expectedRejectReason", "solverVerdict"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "answer": {},
                "expectedRejectReason": { "type": "string", "minLength": 1 },
                "solverVerdict": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["correct", "errorType"],
                  "properties": {
                    "correct": { "const": false },
                    "errorType": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contentCommit", "contentHash", "builderVersion", "promptVersion"],
            "properties": {
              "contentCommit": { "type": "string", "minLength": 1 },
              "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "builderVersion": { "type": "string", "minLength": 1 },
              "promptVersion": { "const": null }
            }
          }
        }
      }
    }
  }
}
