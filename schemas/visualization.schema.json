{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/visualization.schema.json",
  "title": "Visualization specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engine", "title", "caption", "boundingbox", "objects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engine": { "const": "jsxgraph" },
    "title": { "type": "string", "minLength": 1 },
    "caption": { "type": "string", "minLength": 1 },
    "boundingbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "axis": { "type": "boolean" },
    "keepAspectRatio": { "type": "boolean" },
    "sliders": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/slider" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/functiongraph" },
          { "$ref": "#/$defs/point" },
          { "$ref": "#/$defs/segment" },
          { "$ref": "#/$defs/text" },
          { "$ref": "#/$defs/polygon" },
          { "$ref": "#/$defs/curve" }
        ]
      }
    }
  },
  "$defs": {
    "expr": { "anyOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
    "coord": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/expr" }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "slider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "range", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "value": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "functiongraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expr"],
      "properties": {
        "kind": { "const": "functiongraph" },
        "expr": { "type": "string", "minLength": 1 },
        "domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/expr" }
        },
        "label": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "dash": { "type": "boolean" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at"],
      "properties": {
        "kind": { "const": "point" },
        "at": { "$ref": "#/$defs/coord" },
        "label": { "type": "string" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to"],
      "properties": {
        "kind": { "enum": ["arrow", "segment"] },
        "from": { "$ref": "#/$defs/coord" },
        "to": { "$ref": "#/$defs/coord" },
        "label": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "dash": { "type": "boolean" }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at", "text"],
      "properties": {
        "kind": { "const": "text" },
        "at": { "$ref": "#/$defs/coord" },
        "text": { "type": "string" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points"],
      "properties": {
        "kind": { "const": "polygon" },
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/coord" } },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points"],
      "properties": {
        "kind": { "const": "curve" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/coord" } },
        "color": { "$ref": "#/$defs/color" },
        "dash": { "type": "boolean" }
      }
    }
  }
}
