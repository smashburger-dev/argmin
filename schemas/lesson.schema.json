{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "lessonId", "version", "locale", "title", "objectives",
    "competencyIds", "requires", "estimatedMinutes", "blocks", "sourceRefs",
    "rightsId", "releaseStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lessonId": { "type": "string", "pattern": "^l-[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "const": "de" },
    "title": { "type": "string", "minLength": 1 },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "competencyIds": { "$ref": "#/$defs/competencyIds" },
    "requires": { "$ref": "#/$defs/requires" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "type", "contentRef"],
        "properties": {
          "blockId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": { "enum": ["prose", "definition", "worked-example", "checkpoint", "visualization", "exercise", "reflection", "project-step", "source-note"] },
          "contentRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "role", "locator"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "role": { "enum": ["primary", "reference", "practice", "remedial"] },
          "locator": { "type": "string" }
        }
      }
    },
    "rightsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "releaseStatus": { "enum": ["draft", "source-verified", "didactic-reviewed", "browser-verified", "public-approved", "local-only"] }
  },
  "$defs": {
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
    }
  }
}
