{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/explanation-card.schema.json",
  "title": "Explanation card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "explanationId", "version", "locale", "title", "competencyIds",
    "diagnosticCodes", "helpLevel", "body", "steps", "sourceRefs", "followUpActivityIds",
    "revealsSolution", "rightsId", "releaseStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "explanationId": { "type": "string", "pattern": "^x-[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "const": "de" },
    "title": { "type": "string", "minLength": 1 },
    "competencyIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" } },
    "diagnosticCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "helpLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
    "body": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "example": { "type": ["string", "null"] },
    "counterexample": { "type": ["string", "null"] },
    "sourceRefs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" } },
    "followUpActivityIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "revealsSolution": { "type": "boolean" },
    "rightsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "releaseStatus": { "enum": ["draft", "source-verified", "didactic-reviewed", "browser-verified", "public-approved", "local-only"] }
  }
}
