{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/source-rights.schema.json",
  "title": "Source rights collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId", "title", "licenseExpression", "redistributionAllowed",
          "commercialUseAllowed", "derivativesAllowed", "allowedProfiles",
          "attribution", "sourceUrl"
        ],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "licenseExpression": { "type": "string", "minLength": 1 },
          "redistributionAllowed": { "type": ["boolean", "null"] },
          "commercialUseAllowed": { "type": ["boolean", "null"] },
          "derivativesAllowed": { "type": ["boolean", "null"] },
          "shareAlikeLicense": { "type": ["string", "null"] },
          "allowedProfiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "const": "public" }
          },
          "attribution": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": ["string", "null"] },
          "verifiedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
