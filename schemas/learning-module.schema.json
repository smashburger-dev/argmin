{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/learning-module.schema.json",
  "title": "Learning module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "moduleId", "version", "locale", "title", "description",
    "competencyIds", "requires", "trackIds", "lessonIds", "placements",
    "projectIds", "rightsId", "releaseStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "moduleId": { "type": "string", "pattern": "^lm-[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "const": "de" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "competencyIds": { "$ref": "#/$defs/competencyIds" },
    "requires": { "$ref": "#/$defs/competencyIds" },
    "trackIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "lessonIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^l-[a-z0-9-]+$" }
    },
    "explanationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^x-[a-z0-9-]+$" }
    },
    "placements": {
      "type": "array",
      "items": { "$ref": "#/$defs/placement" }
    },
    "projectIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^p-[a-z0-9-]+$" }
    },
    "durationOverrideMinutes": { "type": "integer", "minimum": 1 },
    "rightsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "releaseStatus": { "enum": ["draft", "source-verified", "didactic-reviewed", "browser-verified", "public-approved", "local-only"] }
  },
  "$defs": {
    "competencyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placementId", "role", "familyId", "difficulty"],
      "properties": {
        "placementId": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
        "role": { "enum": ["curated", "practice-space"] },
        "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "seed": { "type": "integer" },
        "difficulty": { "enum": ["intro", "core", "stretch", "challenge"] },
        "definitionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "lessonId": { "type": "string", "pattern": "^l-[a-z0-9-]+$" },
        "estimatedMinutes": { "type": "integer", "minimum": 0 },
        "masteryEligible": { "type": "boolean" }
      }
    }
  }
}
