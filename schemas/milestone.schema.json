{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/milestone.schema.json",
  "title": "Milestone collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "milestones"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "const": "de" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestoneId", "locale", "title", "description", "estimatedMinutes",
          "competencyIds", "lessonIds", "projectIds",
          "coverage", "releaseStatus"
        ],
        "properties": {
          "milestoneId": { "type": "string", "pattern": "^ms-[a-z0-9-]+$" },
          "locale": { "const": "de" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "estimatedMinutes": { "type": "integer", "minimum": 0 },
          "competencyIds": { "$ref": "#/$defs/competencyIds" },
          "lessonIds": { "$ref": "#/$defs/ids" },
          "projectIds": { "$ref": "#/$defs/ids" },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["competencyId", "status", "requiredArtifacts"],
              "properties": {
                "competencyId": { "type": "string", "pattern": "^c-[a-z0-9-]+$" },
                "status": { "enum": ["w01-reuse", "w02-w04-expand", "new", "complete"] },
                "requiredArtifacts": {
                  "type": "array",
                  "items": { "enum": ["lesson", "diagnostic", "guided-practice", "evidence-families", "delayed-review", "project-step"] }
                }
              }
            }
          },
          "releaseStatus": { "enum": ["draft", "didactic-reviewed", "browser-verified", "public-approved", "local-only"] }
        }
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "competencyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
    }
  }
}
