{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/exercise-family-cases.schema.json",
  "title": "Exercise family static cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "contract", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "contract": {
      "anyOf": [
        { "$ref": "#/$defs/contract" },
        { "type": "null" }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId", "familyGroup", "summary", "taskArchetype", "authorityMode",
        "masteryEligible", "caseTypes", "difficultyProfiles", "competencyIds",
        "graderId", "activityType"
      ],
      "properties": {
        "familyId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "familyGroup": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "summary": { "type": "string", "minLength": 1 },
        "taskArchetype": { "type": "string", "minLength": 1 },
        "authorityMode": { "enum": ["static"] },
        "masteryEligible": { "type": "boolean" },
        "caseTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId"],
            "properties": {
              "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
              "propertyTest": { "type": "boolean" }
            }
          }
        },
        "difficultyProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["intro", "core", "stretch", "challenge"] }
        },
        "competencyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "graderId": { "type": "string", "minLength": 1 },
        "activityType": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "difficultyProfile", "masteryEligible", "sourceLineage"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "difficultyProfile": { "enum": ["intro", "core", "stretch", "challenge"] },
        "masteryEligible": { "type": "boolean" },
        "sourceLineage": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "competencyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "parameters": { "type": "object" },
        "expected": { "type": "object" },
        "choices": { "type": "array" },
        "prompt": { "type": "string" },
        "fullSolution": { "type": "string" },
        "hints": { "type": "array" },
        "feedbackRules": { "type": "array" },
        "typicalErrors": { "type": "array" },
        "tolerancePolicy": { "type": "object" },
        "activityType": { "type": "string" },
        "graderId": { "type": "string" },
        "traceTable": {},
        "rubric": {},
        "starterCode": { "type": "string" },
        "referenceSolver": { "type": ["string", "object"] },
        "tests": { "type": "array" },
        "packages": { "type": "array" },
        "fragments": { "type": "array" },
        "initialOrder": { "type": "array" },
        "solutionOrder": { "type": "array" },
        "distractors": { "type": "array" },
        "snippet": { "type": "string" },
        "output": { "type": "string" }
      }
    }
  }
}
