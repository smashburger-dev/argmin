{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/project.schema.json",
  "title": "Learning project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "version",
    "locale",
    "title",
    "description",
    "runnerMode",
    "competencyIds",
    "requires",
    "starterFiles",
    "solutionFiles",
    "allowedCommands",
    "testBundleId",
    "deliverables",
    "rightsId",
    "releaseStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^p-[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "const": "de"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "runnerMode": {
      "enum": [
        "browser",
        "local",
        "hybrid"
      ]
    },
    "competencyIds": {
      "$ref": "#/$defs/competencyIds"
    },
    "requires": {
      "$ref": "#/$defs/competencyIds"
    },
    "starterFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      }
    },
    "solutionFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
      }
    },
    "allowedCommands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program",
          "args"
        ],
        "properties": {
          "program": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "testBundleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rightsId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "releaseStatus": {
      "enum": [
        "draft",
        "solver-verified",
        "didactic-reviewed",
        "browser-verified",
        "public-approved",
        "local-only"
      ]
    },
    "legacyWeekId": {
      "type": "string",
      "pattern": "^w[0-9]{2}$"
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600
    }
  },
  "$defs": {
    "competencyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^c-[a-z0-9-]+$"
      }
    }
  }
}
