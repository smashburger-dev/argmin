{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-lernplattform.local/schemas/python-trace.schema.json",
  "title": "Bounded CPython trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "programId", "normalization", "source", "sourceHash", "pythonVersion", "inputs", "events", "stdout"],
  "properties": {
    "kind": { "const": "python-trace" },
    "schemaVersion": { "const": 1 },
    "programId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "normalization": { "const": "s6a-visible-events/v1" },
    "source": { "type": "string", "maxLength": 8192, "pattern": "^[^\r]*$" },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pythonVersion": { "type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$" },
    "inputs": {
      "type": "object", "additionalProperties": false, "maxProperties": 2,
      "properties": {
        "age": { "$ref": "#/$defs/ageInput" },
        "n0": { "$ref": "#/$defs/ledgerInput" },
        "sum0": { "$ref": "#/$defs/accumulatorInput" }
      }
    },
    "events": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/event" } },
    "stdout": { "type": "string", "maxLength": 8192 }
  },
  "$defs": {
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "frameId", "parentFrameId", "function", "event", "line", "bindings", "objects", "output"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 2047 },
        "frameId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "parentFrameId": { "type": ["string", "null"], "maxLength": 128 },
        "function": { "type": "string", "minLength": 1, "maxLength": 128 },
        "event": { "enum": ["start", "line", "call", "return", "exception"] },
        "line": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "bindings": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string", "pattern": "^object:[a-z0-9-]+$" } },
        "objects": { "type": "object", "maxProperties": 128, "additionalProperties": { "$ref": "#/$defs/object" } },
        "output": { "type": "string", "maxLength": 8192 },
        "result": { "type": "string", "pattern": "^object:[a-z0-9-]+$" },
        "exception": { "$ref": "#/$defs/exception" }
      },
      "allOf": [
        { "if": { "properties": { "event": { "const": "return" } }, "required": ["event"] }, "then": { "properties": { "result": { "type": "string" } }, "required": ["result"] } },
        { "if": { "properties": { "event": { "const": "exception" } }, "required": ["event"] }, "then": { "properties": { "exception": { "type": "object" } }, "required": ["exception"] } }
      ]
    },
    "object": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": { "type": { "enum": ["NoneType", "bool", "int", "float", "str", "list", "tuple", "dict"] }, "value": { "type": "string", "maxLength": 2048 } }
    },
    "exception": {
      "type": "object", "additionalProperties": false, "required": ["type", "line"],
      "properties": { "type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" }, "line": { "type": "integer", "minimum": 1, "maximum": 1024 } }
    },
    "ageInput": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": { "type": { "const": "int" }, "value": { "enum": ["16", "17", "18"] } }
    },
    "ledgerInput": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": { "type": { "const": "int" }, "value": { "enum": ["1", "2", "3", "4"] } }
    },
    "accumulatorInput": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": { "type": { "const": "int" }, "value": { "enum": ["0", "1", "2", "3"] } }
    }
  }
}
